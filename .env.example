# ==============================================================================
# PaperHarvester Environment Configuration
# Copy this file to .env and configure provider credentials as needed.
# ==============================================================================

# Contact email used for polite pool requests (Unpaywall, OpenAlex, Crossref)
# Setting this improves rate limits and prevents service blocks.
HARVESTER_EMAIL=user@example.com
UNPAYWALL_EMAIL=user@example.com
OPENALEX_EMAIL=user@example.com
CROSSREF_EMAIL=user@example.com

# Semantic Scholar API Key (optional - increases rate limits from 1 req/s to 100 req/s)
SEMANTIC_SCHOLAR_API_KEY=

# Default CLI overrides (optional)
HARVESTER_WORKERS=5
HARVESTER_TIMEOUT=30
HARVESTER_MAX_RETRIES=3
